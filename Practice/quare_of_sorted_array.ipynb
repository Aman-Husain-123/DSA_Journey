    "nums = [-4,-1,0,3,10]\n",
    "squared = [x**2 for x in nums]\n",
    "\n",
    "for i in range(len(squared)-1):\n",
    "    if squared[i] > squared[i + 1]:\n",
    "        squared[i], squared[i + 1] = squared[i + 1], squared[i]\n",
    "print(squared)s"
   ]
