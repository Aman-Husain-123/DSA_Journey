   "source": [
    "arr = [0, 0, 1, 1, 0]\n",
    "\n",
    "left, right = 0, len(arr) - 1\n",
    "\n",
    "while left < right:\n",
    "    if arr[left] == 0:\n",
    "        left += 1\n",
    "    elif arr[right] == 1:\n",
    "        right -= 1\n",
    "    else:\n",
    "        arr[left],arr[right] = arr[right],arr[left]\n",
    "        left += 1\n",
    "        right -= 1\n",
    "print(arr)"
   ]
