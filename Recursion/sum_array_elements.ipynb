   "source": [
    "# Using Recursion\n",
    "def sum_array(arr):\n",
    "    # Base Case\n",
    "    if not arr:\n",
    "        return 0\n",
    "    return arr[0] + sum_array(arr[1:])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "4e17e82b",
   "metadata": {},
