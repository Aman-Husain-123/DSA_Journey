   "outputs": [],
   "source": [
    "def reverse_number(n, rev=0):\n",
    "    # Base case\n",
    "    if n == 0:\n",
    "        return rev\n",
    "\n",
    "    digit = n % 10\n",
    "    return reverse_number(n // 10, rev * 10 + digit)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
