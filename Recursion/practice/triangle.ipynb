   "source": [
    "def print_sum_triangle(arr):\n",
    "    if len(arr) == 0:\n",
    "        return\n",
    "    \n",
    "    next_arr = [arr[i] + arr[i+1] for i in range(len(arr) - 1)]\n",
    "    print_sum_triangle(next_arr)\n",
    "    print(arr)"
   ]
