   "source": [
    "def isPower(n):\n",
    "    # Base case 2^0 = 1\n",
    "    if n == 1:\n",
    "        return True\n",
    "    \n",
    "    # Invalid cases\n",
    "    if n < 1 or n % 2 != 0:\n",
    "        return False\n",
    "    \n",
    "    # Recursive case\n",
    "    return isPower(n // 2)"
   ]
  },
  {
