   "source": [
    "def addingoddnum(num1:int,num2:int) -> int:\n",
    "    if num1 > num2:\n",
    "        return 0\n",
    "    \n",
    "    if num1 % 2 != 0:\n",
    "        return num1 + addingoddnum(num1 + 1, num2)\n",
    "    else:\n",
    "        return addingoddnum(num1 + 1, num2)"
   ]
  },
