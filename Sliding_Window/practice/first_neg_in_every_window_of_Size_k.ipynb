   "source": [
    "arr = [-8, 2, 3, -6, 10]\n",
    "k = 2\n",
    "\n",
    "n = len(arr)\n",
    "res = []\n",
    "\n",
    "for i in range(n - k + 1):\n",
    "    found = False\n",
    "\n",
    "    for j in range(i,i+k):\n",
    "        if arr[j] < 0:\n",
    "            res.append(arr[j])\n",
    "            found = True\n",
    "            break\n",
    "    if not found:\n",
    "        res.append(0)\n",
    "print(res)"
   ]
  }
 ],
