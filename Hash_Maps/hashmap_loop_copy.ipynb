   "id": "28aa74c3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Aman\n",
      "20\n",
      "Python\n"
     ]
    }
   ],
   "source": [
    "# Values Printing\n",
    "for x in input_dict:\n",
    "    print(input_dict[x])"
   ]
  },
  {
   "cell_type": "code",
