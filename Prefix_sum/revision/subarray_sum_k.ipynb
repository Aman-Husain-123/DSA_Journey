    "k = 2\n",
    "count = 0\n",
    "for i in range(len(arr)):\n",
    "    curr_sum = 0\n",
    "    for end in range(i,len(arr)):\n",
    "        curr_sum += arr[end]\n",
    "        if curr_sum == k:\n",
    "            count += 1 \n",
    "print(count)"
