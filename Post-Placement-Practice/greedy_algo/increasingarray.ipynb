   "source": [
    "arr = [3,2,5,1,7]\n",
    "moves = 0\n",
    "\n",
    "n = len(arr)\n",
    "# arr = list(map(int, input().split()))\n",
    "\n",
    "moves = 0\n",
    "\n",
    "for i in range(1, n):\n",
    "    if arr[i] < arr[i - 1]:\n",
    "        moves += arr[i - 1] - arr[i]\n",
    "        # arr[i] = arr[i - 1]\n",
    "        # print(arr[i])\n",
    "\n",
    "\n",
    "print(moves)"
   ]
  }
