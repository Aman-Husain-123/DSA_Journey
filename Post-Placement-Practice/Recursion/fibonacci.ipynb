   "source": [
    "# Using Recursion\n",
    "def fibo(n):\n",
    "    if n == 1 or n == 2:\n",
    "        return 1\n",
    "    left = fibo(n - 1)\n",
    "    right = fibo(n-2)\n",
    "\n",
    "    return left + right\n",
    "fibo(5)"
   ]
  }
