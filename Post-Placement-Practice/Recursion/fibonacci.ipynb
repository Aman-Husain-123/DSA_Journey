    "# Using For loop\n",
    "\n",
    "a = 1\n",
    "b = 1\n",
    "n = 8\n",
    "\n",
    "for i in range(n+1):\n",
    "    summ = a + b\n",
    "    a = b\n",
    "    b = summ\n",
    "\n",
    "print(b)\n"
   ]
