   "source": [
    "def zigzag(n):\n",
    "    if n == 0:\n",
    "        return \n",
    "    \n",
    "    print(n,end=\"\")\n",
    "    zigzag(n-1)\n",
    "\n",
    "    print(n,end=\"\")\n",
    "    zigzag(n-1)\n",
    "\n",
    "    print(n,end=\"\")\n",
    "\n",
    "zigzag(10)"
   ]
