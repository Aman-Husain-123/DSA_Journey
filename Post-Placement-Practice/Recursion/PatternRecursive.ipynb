   "source": [
    "# Loop\n",
    "def f(n,r):\n",
    "    if r > n:\n",
    "        return\n",
    "    for i in range(1,r+1):\n",
    "        print(\"*\",end=\"\")\n",
    "\n",
    "    print()\n",
    "    f(n,r+1)\n",
    "\n",
    "f(5,1)"
   ]
