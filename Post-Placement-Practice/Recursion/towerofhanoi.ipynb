   "source": [
    "def hanoi(n, source, helper, target):\n",
    "    # Base Case\n",
    "    if n == 0:\n",
    "        return\n",
    "\n",
    "    # For n-1, target becomes helper, and helper becomes target\n",
    "    hanoi(n-1,source,target,helper)\n",
    "    print(f'{source} -> {target}')\n",
    "    hanoi(n-1,helper,source,target)\n",
    "\n",
    "n = 2\n",
    "hanoi(n,'A','B','C')"
   ]
  },
