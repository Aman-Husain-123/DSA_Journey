    "def reverse(arr,i):\n",
    "    if i == len(arr):\n",
    "        return\n",
    "    reverse(arr,i+1)\n",
    "    print(arr[i],end=\" \")\n",
    "\n",
    "arr = [1,2,3,4,5]\n",
    "reverse(arr,0)"
   ]
