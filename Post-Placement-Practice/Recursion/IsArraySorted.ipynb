   "source": [
    "def f(arr, i):\n",
    "    # Base case: reached end of array\n",
    "    if i == len(arr):\n",
    "        return False\n",
    "\n",
    "    return (arr[i] <= arr[i+1]) and f(arr, i + 1)\n",
    "\n",
    "\n",
    "arr = [32, 324, 322, 12, 4]\n",
    "# x = 12\n",
    "\n",
    "print(f(arr, 0))"
   ]
  }
