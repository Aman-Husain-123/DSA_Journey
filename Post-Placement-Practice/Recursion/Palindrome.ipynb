   "source": [
    "def f(s, l, r):\n",
    "    if l > r:\n",
    "        return True\n",
    "    if s[l] != s[r]:\n",
    "        return False\n",
    "    else:\n",
    "        return f(s, l + 1, r - 1)\n",
    "\n",
    "\n",
    "s = 'randi'\n",
    "f(s,0,len(s)-1)"
   ]
  }
