    "    if a == b:\n",
    "        return 0\n",
    "    \n",
    "    summ = 0\n",
    "\n",
    "    if a % 2 != 0:\n",
    "        summ += a\n",
    "    \n",
    "    summ += func(a+1,b)\n",
    "\n",
    "    return summ\n",
    "func(2,10)"
