   "source": [
    "def f(n,o,c,output):\n",
    "    res = []\n",
    "    if c == n:\n",
    "        res.append(output)\n",
    "        return res\n",
    "    \n",
    "    if o > c:\n",
    "        res += f(n,o,c+1,output+')')\n",
    "    \n",
    "    if o < n:\n",
    "        res += f(n,o+1,c,output+'(')\n",
    "    \n",
    "    return res\n",
    "\n",
    "# Driver code\n",
    "n = 1\n",
    "f(n,0,0,'')"
   ]
  }
 ],
