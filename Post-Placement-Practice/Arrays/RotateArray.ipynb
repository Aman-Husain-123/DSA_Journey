   "source": [
    "nums = [1,2,3,4,5,6,7]\n",
    "k = 3\n",
    "n = len(nums)\n",
    "temp = [0] * n\n",
    "\n",
    "for i in range(n):\n",
    "    temp[(i + k) % n] = nums[i]\n",
    "\n",
    "nums[:] = temp\n",
    "nums"
   ]
  }
