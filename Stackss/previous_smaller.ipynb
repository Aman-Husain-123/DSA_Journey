   ],
   "source": [
    "arr = [1, 6, 2]\n",
    "res = [-1] * len(arr)\n",
    "stack = []\n",
    "\n",
    "for i in range(len(arr)):\n",
    "    while stack and stack[-1] >= arr[i]:\n",
    "        stack.pop()\n",
    "    if stack:\n",
    "        res[i] = stack[-1]\n",
    "    stack.append(arr[i])\n",
    "    \n",
    "print(res)  # Output: [-1, 1, 1]"
   ]
  }
 ],
