   "source": [
    "# Brute Force\n",
    "arr = [1, 2, 3, 4, 5]\n",
    "res = [-1] * len(arr)\n",
    "st = []\n",
    "\n",
    "for i in range(len(arr)):\n",
    "    while st and st[-1] <= arr[i]:\n",
    "        st.pop()\n",
    "    \n",
    "    if st:\n",
    "        res[i] = st[-1]\n",
    "    \n",
    "    st.append(arr[i])\n",
    "print(res)"
   ]
  }
 ],
