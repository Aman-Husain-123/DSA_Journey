   "source": [
    "nums = [1,2,1]\n",
    "n = len(nums)\n",
    "res = [0] * n\n",
    "stack = []\n",
    "\n",
    "for i in range(n - 1, -1, -1):\n",
    "    stack.append(nums[i])\n",
    "\n",
    "for j in range(n - 1, -1, -1):\n",
    "    while stack and stack[-1] <= nums[j]:\n",
    "        stack.pop()\n",
    "    if stack:\n",
    "        res[j] = stack[-1]\n",
    "    stack.append(nums[j])\n",
    "print(res)"
   ]
  }
 ],
