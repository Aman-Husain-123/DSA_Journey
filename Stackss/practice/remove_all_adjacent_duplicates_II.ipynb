   "source": [
    "s = \"abccd\"\n",
    "k = 2\n",
    "\n",
    "stack = []\n",
    "\n",
    "for ch in s:\n",
    "    if stack and stack[-1][0] == ch:\n",
    "        stack[-1][1] += 1\n",
    "        \n",
    "        if stack[-1][1] == k:\n",
    "            stack.pop()\n",
    "    else:\n",
    "        stack.append([ch, 1])\n",
    "\n",
    "ans = ''.join(ch * cnt for ch, cnt in stack)\n",
    "print(ans)"
   ]
  }
 ],
