   "source": [
    "s = \"abbaca\"\n",
    "st = []\n",
    "\n",
    "if len(s) == 0:\n",
    "    print(\"No char in string\")\n",
    "\n",
    "for i in range(len(s)):\n",
    "    if st and st[-1] == s[i]:\n",
    "        st.pop()\n",
    "    else:\n",
    "        st.append(s[i])\n",
    "\n",
    "print(\"The string is:\", \"\".join(st))"
   ]
