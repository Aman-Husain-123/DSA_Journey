   "source": [
    "arr = [4, 8, 5, 2, 25]\n",
    "res = [-1] * len(arr)\n",
    "stack = []\n",
    "for i in range(len(arr) - 1, -1, -1):\n",
    "    while stack and stack[-1] > arr[i]:\n",
    "        stack.pop()\n",
    "    if stack:\n",
    "        res[i] = stack[-1]\n",
    "    stack.append(arr[i])\n",
    "print(res)"
   ]
  }
