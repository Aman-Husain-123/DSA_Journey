    "# Brute Approach\n",
    "arr = [1,2,1,3,4,2]\n",
    "for i in range(len(arr)):\n",
    "    for j in range(i+1, len(arr)):\n",
    "        if arr[i] == arr[j]:\n",
    "            print(arr[i])"
   ]
