   "source": [
    "arr = [-2,1-3,4,-1,2]\n",
    "best_ending = arr[0]\n",
    "ans = arr[0]\n",
    "\n",
    "for i in range(1, len(arr)):\n",
    "    v1 = best_ending + arr[i]\n",
    "    v2 = arr[i]\n",
    "\n",
    "    # Max subarray at each index\n",
    "    best_ending = max(v1, v2)\n",
    "\n",
    "    # Max subarray overall\n",
    "    ans = max(ans, best_ending)\n",
    "\n",
    "print(ans)"
   ]
  }
 ],
